# 복사해서 .env 로 쓰세요. 실제 값은 절대 커밋하지 마세요.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=your-secret-key
DATA_GO_KR_KEY=
ADMIN_TOKEN=아무도-모르는-긴-문자열
SIDO_NAME=제주
COLLECT_MINUTES=60

# 로컬: 프론트를 127.0.0.1:5000 으로 열 때
# Railway 배포: Vercel 주소로 바꾸기 (끝에 / 없이, 여러 개면 쉼표)
FRONT_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
